# Required
BOT_TOKEN=123456789:replace_with_real_botfather_token
BOT_MODE=WEBHOOK
RENDER_EXTERNAL_URL=https://your-service.onrender.com
WEBHOOK_SECRET_TOKEN=replace_with_random_header_secret_32_chars
WEBHOOK_PATH_SECRET=replace_with_different_random_path_secret
BOT_OWNER_IDS=123456789

# v3.5 stability and administration
STARTUP_VALIDATION_STRICT=true
PERSISTENCE_RETRY_ATTEMPTS=4
PERSISTENCE_RETRY_BASE_DELAY_SECONDS=0.35
PERSISTENCE_RETRY_MAX_DELAY_SECONDS=5
PERSISTENCE_RETRY_JITTER_RATIO=0.20
LOCAL_PERSISTENCE_ENABLED=false
REDIS_LEGACY_PICKLE_LOAD_ENABLED=false

# Choose Redis, Supabase, or both
REDIS_ENABLED=false
REDIS_URL=
REDIS_STATE_SIGNING_SECRET=replace_with_random_state_signing_secret
SUPABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=bot_state

# Mini App
MINI_APP_API_ENABLED=true
MINI_APP_CORS_ORIGINS=https://your-mini-app.example.com
SERVER_LOG_AUTH_QUERY_ENABLED=false
SERVER_LOG_PUBLIC_ACCESS=false

# UI release label
PROFESSIONAL_UI_VERSION=v3.5
